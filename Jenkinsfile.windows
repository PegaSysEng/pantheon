pipeline {
    agent {
        docker {
            image "openjdk:8-windowsservercore-1809"
            label "windows"
        }
    }
    stages {
        stage("Build") {
            steps {
                bat ".\\gradlew build"
            }
            post {
                always {
                    junit "**\\build\\test-results\\**\\*.xml"
                }
            }
        }
    }
}
