// invokeDocker.groovy
def runDocker(image, cmd) {
    powershell """
        docker run `
          --rm `
          -w "${env.WORKSPACE}" `
          -v "${env.WORKSPACE}:${env.WORKSPACE}:rw" `
          -e "WORKSPACE=${env.WORKSPACE}" `
          -e "BUILD_NUMBER=${env.BUILD_NUMBER}" `
          $image powershell -C "$cmd"
    """
}

def image = "openjdk:8-windowsservercore-1809"

pipeline {
    agent {
        label "windows"
    }
    stages {
        stage("Build") {
            steps {
                runDocker(image, ".\\gradlew build")
            }
            post {
                always {
                    junit "**\\build\\test-results\\**\\*.xml"
                }
            }
        }
    }
}
